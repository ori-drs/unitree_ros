<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="z1">

    <xacro:include filename="$(find z1_description)/xacro/z1.xacro" />

    <xacro:arg name="arm_root" default="root" />
    <xacro:arg name="unitree_gripper" default="true" />
    <xacro:arg name="robotiq_gripper" default="false" />
    <xacro:arg name="realsense" default="true" />
    <xacro:arg name="arm_ns" default="z1_gazebo" />
    <xacro:arg name="sim" default="false" />

    <xacro:property name="arm_root" value="$(arg arm_root)" />
    <link name="${arm_root}" />

    <!-- for gazebo -->
    <link name="world" />

    <joint name="connect_root_and_world" type="fixed">
        <child link="${arm_root}" />
        <parent link="world" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <xacro:z1 base_parent="${arm_root}" unitree_gripper="$(arg unitree_gripper)"
        robotiq_gripper="$(arg robotiq_gripper)"
        realsense="$(arg realsense)" robot_namespace="$(arg arm_ns)" sim="$(arg sim)" />
</robot>